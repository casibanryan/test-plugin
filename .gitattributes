# Default: let git normalise text in the repository and check it out natively.
* text=auto

# contract.lock.json is compared BYTE FOR BYTE against `JSON.stringify(..., 2) + '\n'`
# by `npm run contract:verify`. Checked out with CRLF on Windows it would never match,
# so the lock is pinned to LF and the check means the same thing on every platform.
packages/contract/contract.lock.json text eol=lf

# Every generated client config is regenerated and compared exactly, the same way.
# Checked out with CRLF, a config would read as drifted on the first `clients:check`
# after a fresh clone on Windows — so all of them are pinned, not just the plugin's.
packages/clients/*/.mcp.json text eol=lf
packages/clients/*/config.toml text eol=lf
packages/clients/*/settings.json text eol=lf

# Shell scripts are executed by Linux (App Service, CI runners); CRLF breaks a shebang.
*.sh text eol=lf

# The canonical server and the copies `clients:generate` writes into each plugin are
# compared BYTE FOR BYTE by `npm run clients:verify`. Checked out with CRLF on Windows
# the copy would never match its source, so both sides are pinned to LF and the check
# means the same thing on every platform.
packages/server/** text eol=lf
packages/clients/*/server/** text eol=lf
