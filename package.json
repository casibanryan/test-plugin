{
  "name": "pivotly-ai",
  "version": "0.2.0",
  "private": true,
  "description": "Pivotly AI monorepo: contract (source of truth), hub (cloud MCP server), and the Axle Claude client.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/contract",
    "packages/hub",
    "packages/clients/axle",
    "e2e"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:contract": "npm test -w @pivotly/contract",
    "test:hub": "npm test -w @pivotly/hub",
    "test:axle": "npm test -w @pivotly/axle",
    "contract:digest": "node packages/contract/bin/contract-digest.js",
    "contract:verify": "node packages/contract/bin/contract-digest.js --verify",
    "versions:verify": "node scripts/verify-versions.js",
    "dev:hub": "npm run dev -w @pivotly/hub",
    "hub:selftest": "npm run selftest -w @pivotly/hub",
    "smoke": "node packages/hub/scripts/smoke-remote.js",
    "e2e": "npm run e2e -w @pivotly/e2e",
    "axle:autopatch": "npm run autopatch -w @pivotly/axle",
    "axle:verify": "npm run verify -w @pivotly/axle",
    "verify:upstream": "npm run verify:upstream -w @pivotly/hub",
    "dev:api": "node packages/hub/scripts/fake-platform-api.js --port=8790",
    "package:hub": "node scripts/package-hub.js",
    "verify:all": "npm run contract:verify && npm run versions:verify && npm test && npm run axle:verify"
  }
}
