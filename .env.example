# ---------------------------------------------------------------------------
# Local development only.
#
#   cp .env.example .env
#
# Loaded by Node's own --env-file-if-exists (no dotenv dependency), and only by the
# LOCAL-facing npm scripts: dev:hub, dev:api, stdio, e2e, smoke, verify:upstream.
#
# `npm start` deliberately does NOT read this file. Deployed channels get their
# configuration from Azure App Settings, so a .env that happened to be packaged could
# never silently override production. See docs/PIPELINE.md.
#
# One thing this file CANNOT do: give Claude Code the plugin's token. Claude Code
# starts the MCP connection itself and expands ${PIVOTLY_MCP_TOKEN} from ITS OWN
# environment, not from this file. Set that one in your shell or user environment —
# see the note beside it below.
#
# Note what is NOT in this file: there is no database URL, because the hub has no
# database. It reaches every record and every job through the platform API, which
# owns the schema and the access rules. See docs/ARCHITECTURE.md.
# ---------------------------------------------------------------------------

# --- hub: transport -------------------------------------------------------
PORT=8787
HUB_MODE=http                     # http | stdio
HUB_CHANNEL=local                 # local | dev | prerelease | production
HUB_LOG_LEVEL=info                # debug | info | warn | error

# --- hub: the platform API (its only data source) -------------------------
# Must be https except on loopback in an unhardened channel: the caller's bearer
# token is forwarded upstream, so plaintext would put every token on the wire.
#
# For local work, `npm run dev` starts the fake platform API on 8790. It is a TEST
# DOUBLE (packages/hub/scripts/fake-platform-api.js), not a second implementation.
PIVOTLY_API_URL=http://127.0.0.1:8790
PIVOTLY_API_TIMEOUT_MS=8000
PIVOTLY_API_MAX_ATTEMPTS=3         # 3 x 8s must stay under HUB_REQUEST_TIMEOUT_MS
PIVOTLY_API_RETRY_DELAY_MS=250

HUB_REQUEST_TIMEOUT_MS=30000       # stay well inside App Service's 230s cutoff
HUB_MAX_BODY_BYTES=1048576

# --- hub: stdio mode only -------------------------------------------------
# stdio has no per-request headers to carry a credential, so it authenticates once
# from this. Unhardened channels only.
HUB_STDIO_TOKEN=dev-token

# --- clients/axle ---------------------------------------------------------
# The plugin's token. Read-only by construction: the platform issues it as a
# `client` principal, which the API refuses for every write.
#
# IMPORTANT: setting it HERE is not enough for the plugin to work. Claude Code
# launches the MCP connection from its own process and expands ${PIVOTLY_MCP_TOKEN}
# from the environment IT was started with. A repo .env never reaches it — that is
# what a `token_invalid` error from the hub usually means. Set it for real with:
#
#   PowerShell (this user, persists):  setx PIVOTLY_MCP_TOKEN "dev-token"
#   bash (this shell only):            export PIVOTLY_MCP_TOKEN=dev-token
#
# then restart Claude Code so it picks the value up.
PIVOTLY_MCP_TOKEN=dev-token
PIVOTLY_CHANNEL=local

# --- pipeline verifiers (see docs/PIPELINE.md) ----------------------------
# A read-only client token used by the deployed-endpoint smoke tests.
SMOKE_TOKEN=smoke-token
# A service token, used only by scripts/verify-upstream.js to prove the API refuses
# a client credential's write. Never given to a client.
VERIFY_SERVICE_TOKEN=worker-token
