# ---------------------------------------------------------------------------
# Local development. Optional — every value below has a working default, so
# `npm run dev:hub` runs with no .env at all.
#
#   cp .env.example .env
#
# Loaded by Node's own --env-file-if-exists (no dotenv dependency), and only by the
# local-facing scripts: dev:hub, stdio, e2e, smoke.
#
# `npm start` deliberately does NOT read it. Deployed channels get their configuration
# from Azure App Settings, so a stray .env can never override a real channel.
#
# Note what is NOT here: no database URL, no API URL, and no token. The hub serves two
# read-only greeting tools computed in-process, so it has nothing to connect to and
# nothing to protect. See docs/ARCHITECTURE.md.
# ---------------------------------------------------------------------------

# --- hub ------------------------------------------------------------------
PORT=8787
HUB_MODE=http                     # http | stdio
HUB_CHANNEL=local                 # local | dev | prerelease | production
HUB_LOG_LEVEL=info                # debug | info | warn | error

HUB_REQUEST_TIMEOUT_MS=30000      # stay well inside App Service's 230s cutoff
HUB_MAX_BODY_BYTES=1048576

# --- clients --------------------------------------------------------------
# Which channel `npm run clients:generate` writes into every client config.
# Set this to `local` while developing, and back to `production` before committing —
# CI fails if the committed configs do not match the manifest's default channel.
PIVOTLY_CHANNEL=local

# --- pipeline scripts -----------------------------------------------------
# Default target for `npm run smoke` and `npm run e2e` when no --hub-url is passed.
# HUB_URL=https://pivotly-hub-dev.azurewebsites.net

# with azure
