{
  "name": "@pivotly/hub",
  "version": "0.3.1",
  "private": true,
  "description": "Pivotly MCP hub: a stateless, anonymous, cloud-hosted MCP server. Two read-only greeting tools, no database, no upstream API, no credentials.",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --env-file-if-exists=../../.env src/index.js --http",
    "stdio": "node --env-file-if-exists=../../.env src/index.js --stdio",
    "selftest": "node src/index.js --selftest",
    "test": "node --test",
    "smoke": "node --env-file-if-exists=../../.env scripts/smoke-remote.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@pivotly/contract": "*",
    "zod": "^3.25.76"
  },
  "exports": {
    "./src/index": "./src/index.js",
    "./src/mcp": "./src/mcp.js",
    "./scripts/smoke-remote": "./scripts/smoke-remote.js"
  }
}
